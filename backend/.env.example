# Copy to .env and adjust. Every value has a safe default.

# Where enquiries are stored. The folder is created automatically.
THRIKO_EXCEL_PATH=data/enquiries.xlsx

# Comma-separated list of origins allowed to call the API from a browser.
THRIKO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max form submissions per client IP within the window below.
THRIKO_RATE_LIMIT_REQUESTS=5
THRIKO_RATE_LIMIT_WINDOW_SECONDS=60

# Set to true only when running behind a reverse proxy you control,
# so the client IP is read from X-Forwarded-For.
THRIKO_TRUST_PROXY_HEADERS=false

# Optional: path to the built frontend (frontend/dist) to serve the site
# and API from one process. Leave empty when hosting the frontend separately.
THRIKO_FRONTEND_DIST=

THRIKO_LOG_LEVEL=INFO

# Base URL of the Python API. Leave empty to use relative /api URLs
# (recommended: the dev server proxies /api, and in production serve both
# behind one domain or a reverse proxy).
VITE_API_BASE_URL=

# Where the dev server proxies /api requests to.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Public contact email shown on the site.
VITE_CONTACT_EMAIL=career@thriko.com

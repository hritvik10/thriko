# Base URL of the Python API. Leave empty to use relative /api URLs
# (recommended: the dev server proxies /api, and in production serve both
# behind one domain or a reverse proxy).
VITE_API_BASE_URL=

# Where the dev server proxies /api requests to.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Cloudflare Turnstile site key. Public by design: it ships in the bundle.
# Leave empty to turn the bot check off (local development against the Python API).
#
# A real sitekey only works on the hostnames allowed for it, so it will not
# render on localhost. For local work use Cloudflare's dummy sitekey, which
# works anywhere, and set the real one as a build variable in Cloudflare:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Public contact email shown on the site.
VITE_CONTACT_EMAIL=hello@thriko.com

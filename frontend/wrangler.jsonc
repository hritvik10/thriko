{
  "name": "thriko3co",
  "compatibility_date": "2026-10-01",
  "previews": {},
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer /api/* with index.html
    // instead of letting the Worker handle it.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
